{
  "name": "classroom-reservation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply classroom-reservation --local",
    "db:remote": "wrangler d1 migrations apply classroom-reservation --remote",
    "kakao:connect": "node scripts/connect-kakao.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/worker.js && node --check public/app.js"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
