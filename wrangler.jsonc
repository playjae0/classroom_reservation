{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classroom-reservation",
  "keep_vars": true,
  "main": "src/worker.js",
  "compatibility_date": "2026-11-07",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "classroom-reservation",
    "database_id": "7d8b5245-6194-4ec3-a572-86d066cc256f",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "APP_NAME": "원우 강의실 예약", "RETENTION_DAYS": "90", "PUBLIC_APP_URL": "https://classroom-reservation.motfriends.workers.dev" },
  "observability": { "enabled": false }
}
